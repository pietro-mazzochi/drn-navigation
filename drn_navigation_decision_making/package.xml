<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drn_navigation_decision_maker</name>
  <version>0.0.1</version>
  <description>
    A ROS2 package implementing a state machine and behavior tree-based decision making system 
    for mobile robot navigation and task execution in industrial environments.
  </description>
  <maintainer email="dionata.silva@isisim.org.br">dionata</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Core ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  
  <!-- Vision dependencies -->
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>opencv</depend>

  <!-- Custom message dependencies -->
  <depend>drn_navigation_msgs</depend>
  <depend>drn_perception_msgs</depend>
  <depend>drn_integration_msgs</depend>
  <depend>siemens_et200sp_modbus_driver_msgs</depend>

  <!-- Behavior Tree dependencies -->
  <depend>behaviortree_cpp</depend>
  <depend>behaviortree_cpp_v3</depend>

  <!-- Navigation dependencies -->
  <depend>nav2_msgs</depend>
  <depend>nav2_behavior_tree</depend>
  <depend>nav2_costmap_2d</depend>

  <!-- Python dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <!-- Testing dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>