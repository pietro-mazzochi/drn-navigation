
<!--
  This Behavior Tree replans the global path periodically at 1 Hz through an array of poses continuously
   and it also has recovery actions specific to planning / control as well as general system issues.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="Navigate">
      <TimeSelector selected_time="{selected_time}" default_time="5.0" topic_name="time_selector"/>
      <RecoveryNode number_of_retries="4" name="NavigateRecovery">
        <PipelineSequence name="NavigateWithReplanning">
          
          <RateController hz="20.0">
            <RecoveryNode number_of_retries="3" name="ComputePathThroughPoses">
              <Fallback>
                <ReactiveSequence>
                  <Inverter>
                    <PathExpiringTimer seconds="0.25" path="{path}"/>
                  </Inverter>
                  <Inverter>
                    <GlobalUpdatedGoal/>
                  </Inverter>
                  <IsPathValid path="{path}"/>
                </ReactiveSequence>
                <ReactiveSequence>
                  <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="1.1"/>
                  <RemoveInCollisionGoals input_goals="{goals}" output_goals="{goals}" cost_threshold="80.0" use_footprint="false" consider_unknown_as_obstacle="false" service_name="/global_costmap/get_cost_global_costmap" /> 
                  <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
                </ReactiveSequence>
              </Fallback>
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            </RecoveryNode>
          </RateController>

          <PathLonger path="{path}" prox_len="1.0" length_factor="1.2">
            <ReactiveFallback name="RecoveryFallback_path">
              <GoalUpdated/>
              <RoundRobin name="RecoveryActions_path">
                <Wait wait_duration="1.0"/>
                <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              </RoundRobin>
            </ReactiveFallback>  
          </PathLonger>
          
          <RateController hz="20.0">
            <RecoveryNode number_of_retries="1" name="FollowPath">
              <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>
              <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            </RecoveryNode>
          </RateController>

        </PipelineSequence>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <WaitPrint wait_duration="{selected_time}"/>
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RoundRobin>
        </ReactiveFallback>
      </RecoveryNode>
    </PipelineSequence>
  </BehaviorTree>
</root>